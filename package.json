{
  "name": "distkit",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "description": "A minimal registry and CLI for distributing open code. Fork it and build your own.",
  "author": "Favour Emeka <favorodera@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/favorodera",
  "homepage": "https://github.com/favorodera/distkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/distkit.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/distkit/issues"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0 <25.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "scripts": {
     "dev": "turbo dev",
    "dev:all": "turbo dev play",
    "play": "turbo play",
    "build": "turbo build",
    "lint": "pnpm lint:root && turbo lint",
    "lint:root": "eslint .",
    "lint:root:fix": "eslint . --fix",
    "lint:fix": "pnpm lint:root:fix && turbo lint:fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "preview": "turbo preview",
    "prepublishOnly": "turbo prepublishOnly",
    "ready": "pnpm install && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@favorodera/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "relizy": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "pkg-pr-new":"catalog:"
  }
}
