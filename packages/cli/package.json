{
  "name": "@distkit/cli",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Command-line interface for resolving, validating, and installing items from a distkit registry.",
  "author": "Favour Emeka <favorodera@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/favorodera",
  "homepage": "https://github.com/favorodera/distkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/distkit.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/distkit/issues"
  },
  "keywords": [
    "distkit",
    "registry",
    "cli"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./types": "./dist/types.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "distkit": "./bin/distkit.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test:watch": "vitest watch --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@distkit/schema": "workspace:*",
    "c12": "catalog:",
    "citty": "catalog:",
    "fs-extra": "catalog:",
    "json5": "catalog:",
    "nypm": "catalog:",
    "ofetch": "catalog:",
    "pathe": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@favorodera/eslint-config": "catalog:",
    "@types/fs-extra": "catalog:",
    "@vitest/ui": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
