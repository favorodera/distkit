{
  "name": "@distkit/core",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "defineConfig() and the distkit CLI binary — the package consumers actually install.",
  "author": "Favour Emeka <favorodera@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/favorodera",
  "homepage": "https://github.com/favorodera/distkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/distkit.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/distkit/issues"
  },
  "keywords": [
    "distkit",
    "config",
    "cli"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "distkit": "./bin/distkit.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@distkit/cli": "workspace:*"
  },
  "devDependencies": {
    "@favorodera/eslint-config": "catalog:tooling",
    "tsdown": "catalog:tooling"
  }
}
